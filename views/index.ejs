<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vitality Fitness Club</title><meta name="description" content="Planes, horarios y formas de entrenamiento"><link rel="stylesheet" href="/css/style.css"></head><body>
<% const gymName = settings.business_name && settings.business_name !== 'Tu Marca' ? settings.business_name : 'Vitality Fitness Club'; const whatsapp='56990838154'; const wa='https://wa.me/'+whatsapp; %>
