<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Acceso Administración</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f1f5f9; padding: 1rem;">
    <div style="background: var(--surface); border: 1px solid var(--border); padding: 2rem; border-radius: var(--radius); width: 100%; max-width: 380px; box-shadow: var(--shadow);">
        <h1 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 1.5rem; text-align: center; color: var(--primary);">Panel Leads & Landing</h1>
        
        <% if (error) { %>
            <div style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 0.6rem; border-radius: var(--radius); font-size: 0.825rem; margin-bottom: 1rem;">
                <%= error %>
            </div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label>Usuario</label>
                <input type="text" name="username" required class="form-control" autofocus>
            </div>
            
            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" required class="form-control">
            </div>

            <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
        </form>
    </div>
</body>
</html>
